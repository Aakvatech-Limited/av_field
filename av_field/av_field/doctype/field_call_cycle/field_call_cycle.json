{
  "doctype": "DocType",
  "name": "Field Call Cycle",
  "module": "AV Field",
  "engine": "InnoDB",
  "autoname": "hash",
  "istable": 0,
  "track_changes": 1,
  "field_order": [
    "cycle_name",
    "salesperson",
    "zone",
    "active",
    "stops"
  ],
  "fields": [
    {
      "fieldname": "cycle_name",
      "label": "Call Cycle Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "salesperson",
      "label": "Assigned User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "zone",
      "label": "Route Zone",
      "fieldtype": "Link",
      "options": "Field Route Zone"
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "stops",
      "label": "Recurring Stops",
      "fieldtype": "Table",
      "options": "Field Call Cycle Stop",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "Field Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Field Agent",
      "read": 1
    }
  ]
}
